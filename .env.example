# Environment Configuration Example
# Copy this file to .env.local and update with your values

# Site Configuration
NEXT_PUBLIC_SITE_URL=https://your-domain.com
NEXT_PUBLIC_SITE_NAME=Mohamed Saher Portfolio

# Contact Form (Optional - for email service integration)
# SENDGRID_API_KEY=your_sendgrid_api_key
# CONTACT_EMAIL=mohamed.saher@design.com

# Analytics (Optional)
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Social Media Links (Update in components/Contact.tsx and components/Footer.tsx)
# NEXT_PUBLIC_LINKEDIN_URL=https://linkedin.com/in/your-profile
# NEXT_PUBLIC_BEHANCE_URL=https://behance.net/your-profile
# NEXT_PUBLIC_DRIBBBLE_URL=https://dribbble.com/your-profile
# NEXT_PUBLIC_GITHUB_URL=https://github.com/your-profile
